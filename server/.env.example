# Copy to .env on the server and fill in. Never commit the real file.
# Generate a secret:  openssl rand -base64 48

SECRET_KEY=
ROOT_PATH=/thriauga

# log  = print sign-in codes to `docker logs thriauga-sync` (works immediately)
# smtp = deliver through the internal mail container
MAIL_BACKEND=log

MAIL_DOMAIN=xiaodong.io
MAIL_HOSTNAME=mail.xiaodong.io
MAIL_FROM=thriauga@xiaodong.io
MAIL_FROM_NAME=Thriauga
DKIM_SELECTOR=thriauga
PUBLIC_IP=138.128.194.204

# Optional: send through an external provider instead of direct-to-MX.
# Recommended if Gmail/Outlook reject mail from this IP's generic PTR.
RELAY_HOST=
RELAY_USER=
RELAY_PASS=

RATE_EMAIL_PER_HOUR=5
RATE_IP_PER_HOUR=20
